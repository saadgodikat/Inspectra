# ============================================================
# Quality Inspection & Defect Tracking System — Environment
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.
# ============================================================

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# --- Database ---
# PostgreSQL (production / full dev):
# DATABASE_URL=postgresql://qits_user:changeme@localhost:5432/qits_db
# SQLite (lightweight dev/test):
DATABASE_URL=sqlite:///instance/qits.db

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=16
ALLOWED_EXTENSIONS=png,jpg,jpeg,bmp,tiff,webp

# --- ML Service ---
ML_MODEL_PATH=data/model_checkpoint.pth
ML_DEVICE=cpu
ML_LABELS=good,defect_scratch,defect_dent,defect_stain,defect_crack

# --- GenAI / Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
